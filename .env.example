# Supabase browser configuration for the Vite/React application
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Server-only secret for the Vercel /api/create-user function.
# NEVER expose this value as a VITE_* variable or put it in browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
